# =============================================================================
# Moon Dev Trading Bot Environment Variables
# =============================================================================
# NEVER COMMIT THE ACTUAL .env FILE! THIS IS JUST A TEMPLATE!
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# TRADING DATA APIs
# -----------------------------------------------------------------------------

# BirdEye API - Solana token data, prices, OHLCV, liquidity
# Get key at: https://birdeye.so/
BIRDEYE_API_KEY=your_birdeye_api_key_here

# Moon Dev API - Custom signals (liquidations, funding rates, OI, copybot)
# Get key at: https://moondev.com/
MOONDEV_API_KEY=your_moondev_key_here

# CoinGecko API - 15,000+ token metadata, market caps, sentiment
# Get key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here

# -----------------------------------------------------------------------------
# BLOCKCHAIN / RPC
# -----------------------------------------------------------------------------

# Helius RPC - Solana blockchain interaction (recommended)
# Get endpoint at: https://helius.dev/
RPC_ENDPOINT=your_helius_rpc_endpoint_here

# Solana Wallet Private Key (base58 encoded)
# CAREFUL! Never share this key
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# -----------------------------------------------------------------------------
# EXCHANGE APIs
# -----------------------------------------------------------------------------

# Hyperliquid - Perpetual futures trading
# Generate API key in Hyperliquid app
HYPER_LIQUID_KEY=your_hyperliquid_api_key_here
HYPER_LIQUID_ETH_PRIVATE_KEY=your_eth_private_key_here

# Aster Exchange
ASTER_API_KEY=your_aster_api_key_here
ASTER_API_SECRET=your_aster_api_secret_here

# X10 Exchange
X10_API_KEY=your_x10_api_key_here
X10_PRIVATE_KEY=your_x10_private_key_here
X10_VAULT_ID=your_x10_vault_id_here
X10_PUBLIC_KEY=your_x10_public_key_here

# Network mode (set to false for mainnet, true for testnet)
USE_TESTNET=false

# -----------------------------------------------------------------------------
# AI SERVICE KEYS
# -----------------------------------------------------------------------------

# Anthropic Claude - Primary AI model (recommended)
# Get key at: https://console.anthropic.com/
ANTHROPIC_KEY=your_claude_key_here

# OpenAI - GPT-4, GPT-3.5
# Get key at: https://platform.openai.com/
OPENAI_KEY=your_openai_key_here

# DeepSeek - Reasoning model (used by RBI agent for backtests)
# Get key at: https://platform.deepseek.com/
DEEPSEEK_KEY=your_deepseek_key_here

# Groq - Fast inference
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini
# Get key at: https://aistudio.google.com/
GEMINI_KEY=your_google_api_key_here

# Grok (xAI)
# Get key at: https://x.ai/
GROK_API_KEY=your_grok_api_key_here

# OpenRouter - Access 200+ models
# Get key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_key_here

# ElevenLabs - Text-to-speech for content agents
# Get key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# -----------------------------------------------------------------------------
# SOCIAL MEDIA / CONTENT APIs
# -----------------------------------------------------------------------------

# Twitter/X - For tweet_agent
TWITTER_USERNAME=your_twitter_username_here
TWITTER_EMAIL=your_twitter_email_here
TWITTER_PASSWORD=your_twitter_password_here

# YouTube API - For video downloads and analysis
# Get key at: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Cloud - Speech-to-text, other services
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json

# Restream - Multi-platform streaming
# Get credentials at: https://restream.io/
RESTREAM_CLIENT_ID=your_client_id_here
RESTREAM_CLIENT_SECRET=your_client_secret_here
RESTREAM_EMBED_TOKEN=your_chat_token_here

# Twilio - Phone agent SMS/calls
# Get credentials at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# SECURITY REMINDERS
# =============================================================================
# 1. Never print these values in logs
# 2. Never share your .env file
# 3. Never commit .env to git (it's in .gitignore)
# 4. Revoke and rotate keys if accidentally exposed
# 5. Use separate keys for testnet vs mainnet
# =============================================================================
